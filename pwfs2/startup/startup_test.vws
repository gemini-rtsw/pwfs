# $Id: startup_test.vws,v 1.2 1999-07-17 02:14:36 cboyer Exp $
#
# VxWorks startup script to load and execute system (iocCore) software.
#
# STAND-ALONE VERSION FOR GEMINI NORTH.
#

shellPromptSet "pwfs1 > "

# Make delete key work for backspace
tyBackspaceSet 0177

# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# This file also performs NFS mounts.

< $(version)/bin/$(arch)/local

hostAdd ("archie","10.2.4.56")

# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup
ld < $(epics)/base/bin/$(arch)/devSup

# If using state programs, load the sequencer
ld < $(epics)/base/bin/$(arch)/seq

# Load the syncho bus driver
ld < $(version)/bin/$(arch)/drvVmi5588

# Load the Gemini astrometric and time libraries
ld < $(epics)/extensions/bin/$(arch)/libsla.a
ld < $(epics)/extensions/bin/$(arch)/libtime.a
ld < /gemini/astlib/bin/$(arch)/astlib
ld < /gemini/cfitsio/bin/$(arch)/cFitsIo

ld < $(epics)/extensions/bin/$(arch)/timeSeq

# Load the Gemini data handling libraries
ld < $(version)/bin/$(arch)/strcasecmp
ld < /gemini/dhs/external/lib/vw68k/libers.o
ld < /home/dayle/gemini/dhs27jan99/bin/$(arch)/libimp.o
ld < /home/dayle/gemini/dhs27jan99/bin/$(arch)/libsds.o
ld < /home/dayle/gemini/dhs27jan99/bin/$(arch)/libgen.o
ld < /home/dayle/gemini/dhs27jan99/bin/$(arch)/libdhs.o

# Load the Gemini A&G wavefront processing software
ld < $(version)/bin/$(arch)/wfsDb
ld < $(version)/bin/$(arch)/wfsSite
ld < $(version)/bin/$(arch)/wfsLibraries
ld < $(version)/bin/$(arch)/detControl
ld < $(version)/bin/$(arch)/wfsControl
ld < $(version)/bin/$(arch)/wfsResourceMonitor
ld < $(version)/bin/$(arch)/simpleLog

# Load test harness library if required
ld < $(version)/bin/$(arch)/testHarness
ld < $(version)/bin/$(arch)/testKit

# Load sequences here
# ld < $(version)/bin/$(arch)/testseq.o

# Initialise the Gemini time system (1=master, 1=simulate, intPerSecond, intperTick, timeOffset)
timeClockInit (0, 1, 60, 1, 0)

# Configure the Timestamp system (1=Master IOC, synch rate, clock rate, master, port, timeout, type)
TSconfigure 1, 0, 0, 0, 0, 0, 0

# Load one or more ASCII databases here
dbLoad "$(version)/data/$(dctsdr).dctsdr"

dbLoadRecords "$(version)/data/pwfs1Top.db"
dbLoadRecords "$(version)/data/pwfs1SadTop.db"

# Load the test harness database if required
# DO NOT LOAD THIS DATABASE IF YOU WISH TO CONNECT TO THE REAL TCS
#dbLoadRecords "$(version)/data/testHarnessTop.db"

# This turns off logging
# iocLogDisable=1

# Set logErrorsToPipe = 1 to redirect error messages to the error-logging
# pipe, logErrorsToPipe = 0 will cause errors to be printed at the VxWorks
# console (The simpleLog task will wait indefinitely for its pipe to be
# created when logErrorsToPipe = 0)
#logErrorsToPipe = 1

# Run script to enable 4-sec watchdog-timer reset (if desired)
#< $(version)/bin/$(arch)/wdog_mv167

# start the impmaster
# (Comment this out if the DHS is not being used)
#sp ImpMaster

# Initialise WFS system (processorNumber, redirectLog)
#wfsSysInit (0, logErrorsToPipe)

###initialisation of synchro bus drivers
#vmi5588_init
#vmi5588Debug = 1

#iocInit ("$(version)/data/resource.def")
# IOC Initialisation done

# Set all the "initialising" state to 2=BUSY directly (as it may take a while before
# the PWFS1 is ready to update EPICS record - a deficiency in epToVxLib).
#dbpf "pwfs1:initialising.VAL","2"

# Initialise the database records not initialised by iocInit.
#epToVxCaInitRecords ()
#wfsWriteVersion ()

# Enable console output from error library if required. This is sometimes
# useful if error messages are being diverted to a log file and you wish to
# see a copy of them straight away.
#errorLogConsoleEnable( 1 )

# Initialise the DHS for the detector controllers (clientName, numConnect, hostName, serverName)
# (Uncomment this line to activate the DHS. Comment it to prevent the DHS from being used).
#detDhsInit ("pwfs1", 16, "10.2.4.56", "dataServerNT")

# Spawn generic-record i/o Daemon task after querying the number of processors
NProc = 1
#NProc = sysextNProcGet()
#taskSpawn ("recD", 97, 0x8, 8000, epToVxCaWriteDaemon, NProc)

# Spawn command-control tasks (in stand-alone mode all the WFSs run
# on processor 0)
# NOTE - THE TASK NAMES MUST EXACTLY MATCH THOSE DEFINED IN HEADER FILES.
# A taskDelay has been added after spawning each application task
# to prevent the initialisation messages from getting garbled and
# work around problems which happen when the detector controllers
# try to initialise simulateously.
#taskSpawn ("simpleLog",       99, 0x8, 8000,  simpleLog, 0, 100)
#taskDelay(3 * sysClkRateGet())
#taskSpawn ("p1:detControl",  100, 0x8, 100000, detControl, "p1" , "dc" )
#taskDelay(10 * sysClkRateGet())
#taskSpawn ("wfsControl",     100, 0x8, 6000,  wfsControl)
#taskDelay(3 * sysClkRateGet())

# Spawn CAR Daemon tasks
#taskSpawn ("p1:detControlD", 98, 0x8, 5000, epToVxCarDaemon, "pwfs1:dc:detC")
#taskSpawn ("wfsControlD",    98, 0x8, 5000, epToVxCarDaemon, "pwfs1:controlC")

# Spawn CPU-resource monitoring task
#taskSpawn ("wfsResMonitor", 255, 0x8, 4000, wfsResourceMonitor, 10000000, 200000)

# Start sequences
#seq &timeSeq, "sys=pwfs1:"

# End of standalone startup
