#statTbl: ../statTbl.c
#	$(GCC_EXEC_PREFIX) $(ARCH_DEP_CFLAGS) ../statTbl.c
#
#statTbl.c: $(INC)
#	$(VX_DIR)/bin/solaris/makeStatTbl ..
