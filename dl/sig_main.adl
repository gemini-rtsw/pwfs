"related display" {
	object {
		x="15"
		y="410"
		width="329"
		height="24"
		groupid="0"
	}
	selfkill="off"
	display[0] {
		label="NO_PROCESSING"
		name="sig_mode_none.dl"
		args="top=$(top),sensor=$(sensor),cad=detSigModeNone,car=det"
	}
	display[1] {
		label="SKY/DARK SUBTRACTION"
		name="sig_mode_dark.dl"
