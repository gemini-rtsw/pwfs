# FILENAME
# --------
# local.vws
#
# DESCRIPTION
# -----------
# VxWorks script containing site-specific information for ROE.
#
# DEPENDENCIES
# ------------
# Assumes that the VxWorks boot script executes this file first.
#
# INVOCATION
# ----------
# Invoked from the VxWorks boot script with "<$(version)/bin/$(arch)/local"
#
# AUTHORS
# -------
# Andy Foster   (ajf@ast.cam.ac.uk)
# Steven Beard  (smb@roe.ac.uk)
#-

# Change default network router to the ROE firewall
routeAdd ("0", "195.194.120.254")

# Add useful hosts to network address table
hostAdd ("alba", "195.194.120.7")
hostAdd ("idsun1", "195.194.120.4")
hostAdd ("cicssun1", "195.194.120.8")

# List of authorised users for VxWorks security.
loginUserAdd "cics", "SRebzSdyzS"
loginUserAdd "srp", "SRebzSdyzS"
loginUserAdd "scs", "SRebzSdyzS"
loginUserAdd "sbh", "SRebzSdyzS"

# Do the "nfsMount" here if you are using NFS
#
# nfsMount "<hostname>", "<Name of remote directory to mount>", "<Local device name>"

cd "$(iocpath)"
